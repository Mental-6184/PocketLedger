/**
 * 记账编辑页样式（带自定义数字键盘）
 * 点击金额区域弹出键盘，点击空白处收起
 */

/* 页面包装器 */
.page-wrapper {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

/* 页面滚动容器 */
.page-scroll {
  height: 100%;
  background: var(--color-bg);
}

/* 滚动内容 */
.scroll-content {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  min-height: 100%;
}

/* 键盘弹出时的底部留白 */
.keyboard-placeholder {
  height: 500rpx;
}

/* 类型切换 - 磨砂白底滑块风格 */
.type-switch {
  display: flex;
  background: var(--color-bg);
  border-radius: var(--radius-lg);
  padding: 6rpx;
  margin-bottom: var(--spacing-lg);
  animation: scaleIn 0.25s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  position: relative;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  border-radius: var(--radius-md);
  transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  position: relative;
  z-index: 1;
  -webkit-font-smoothing: antialiased;
}

.type-btn.active {
  background: var(--color-card);
  color: var(--color-text);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 柔和红色 - 降低饱和度 */
.type-btn.active.expense {
  color: #D4605A;
}

.type-btn.active.income {
  color: var(--color-income);
}

/* 底部指示线 */
.type-indicator {
  position: absolute;
  bottom: 0;
  height: 4rpx;
  width: 50%;
  border-radius: 2rpx;
  transition: transform 0.25s ease, background-color 0.25s ease;
}

.type-indicator.expense {
  background: #D4605A;
  transform: translateX(0);
}

.type-indicator.income {
  background: var(--color-income);
  transform: translateX(100%);
}

/* 金额显示区域 */
.amount-display {
  padding: 32rpx;
  animation: fadeInUp 0.3s ease-out both;
  animation-delay: 0.03s;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  cursor: pointer;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.amount-display.active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(42, 161, 152, 0.1);
}

.amount-display-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-display-currency {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-right: 8rpx;
}

.amount-display-value {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -3rpx;
  min-height: 80rpx;
}

.amount-hint {
  text-align: center;
  margin-top: 8rpx;
}

/* 紧凑信息行（日期+备注） */
.compact-info {
  padding: 20rpx 24rpx;
}

.compact-info-row {
  gap: 24rpx;
}

.compact-date,
.compact-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  padding: 12rpx 16rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  gap: 8rpx;
}

.compact-info-label {
  font-size: 28rpx;
}

.compact-info-value {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 账户选择行 */
.account-row {
  padding: 20rpx 24rpx;
}

.account-row-inner {
  align-items: center;
}

.account-row-label {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.account-row-text {
  font-size: 28rpx;
  color: var(--color-text);
}

.account-row-value {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-right: 4rpx;
}

.setting-arrow {
  font-size: 28rpx;
  color: var(--color-text-light);
}

/* 账户选择弹窗 */
.account-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease-out;
}

.account-modal {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 60vh;
  animation: slideUp 0.3s ease-out;
}

.account-modal-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.account-modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.account-list {
  max-height: 50vh;
  overflow-y: auto;
}

.account-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-radius: var(--radius-md);
  transition: background-color 0.15s ease;
}

.account-option:active {
  background: var(--color-bg);
}

.account-option.active {
  background: rgba(42, 161, 152, 0.08);
}

.account-option-left {
  align-items: center;
}

.account-option-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.account-option-name {
  font-size: 28rpx;
  color: var(--color-text);
}

.account-option-check {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 700;
}

/* 退款/报销行 */
.reimburse-row {
  padding: 20rpx 24rpx;
}

.reimburse-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.reimburse-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.linked-name {
  font-size: 24rpx;
  color: var(--color-primary);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.linked-clear {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
  text-align: center;
}

.linked-empty {
  text-align: center;
  padding: 48rpx 0;
}

/* 备注输入弹窗 */
.note-input-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease-out;
}

.note-input-modal {
  width: 80%;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  animation: scaleIn 0.25s ease-out;
}

.note-input-header {
  margin-bottom: 24rpx;
}

.note-input-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.note-input-close {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.note-input-field {
  width: 100%;
  height: 160rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

/* 分类网格 - 磨砂玻璃质感设计 */
.category-card {
  background: linear-gradient(135deg, #F0F4F5 0%, #E8ECEF 100%);
  border-radius: var(--radius-xl);
  padding: 20rpx;
  position: relative;
  overflow: hidden;
}

/* 青灰色纹理背景 */
.category-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(42, 161, 152, 0.04) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(42, 161, 152, 0.03) 0%, transparent 50%);
  pointer-events: none;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(25% - 12rpx);
  padding: 24rpx 0 20rpx;
  border-radius: 20rpx;
  /* 磨砂玻璃效果 */
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.04),
    0 1rpx 3rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  animation: scaleIn 0.2s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  position: relative;
}

/* 暖色光晕效果 */
.category-item::after {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 24rpx;
  background: radial-gradient(circle, rgba(255, 200, 150, 0.08) 0%, transparent 70%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.category-item:hover::after {
  opacity: 1;
}

.category-item:active {
  transform: scale(0.96);
  box-shadow:
    0 2rpx 6rpx rgba(0, 0, 0, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* 选中状态 - 深青色边框 + 暖色光晕 */
.category-item.active {
  background: rgba(42, 161, 152, 0.08);
  border-color: rgba(42, 161, 152, 0.5);
  box-shadow:
    0 4rpx 16rpx rgba(42, 161, 152, 0.15),
    0 0 0 4rpx rgba(42, 161, 152, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.category-item.active::after {
  opacity: 1;
  background: radial-gradient(circle, rgba(42, 161, 152, 0.12) 0%, transparent 70%);
}

.cat-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
  transition: transform 0.25s ease;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.category-item.active .cat-icon {
  transform: scale(1.15);
  filter: drop-shadow(0 3rpx 6rpx rgba(42, 161, 152, 0.2));
}

.cat-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  transition: color 0.25s ease, font-weight 0.25s ease;
  font-weight: 400;
}

.category-item.active .cat-name {
  color: #1E8C82;
  font-weight: 600;
}

/* 操作按钮 */
.actions {
  margin-top: var(--spacing-xl);
}

.actions .btn {
  height: 96rpx;
  font-size: 32rpx;
  border-radius: var(--radius-xl);
}

/* 整体保存区域 */
.save-section {
  margin-top: 32rpx;
  padding: 0 8rpx;
}

.save-btn {
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
}

/* 键盘遮罩层 */
.keyboard-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease-out;
}

/* 自定义数字键盘 - 弹出式 */
.custom-keyboard {
  width: 100%;
  background: #F2F3F5;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.custom-keyboard.show {
  transform: translateY(0);
}

/* 快捷金额行 */
.quick-amount-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.quick-amount-btn {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-primary);
  background: rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-md);
  transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
}

.quick-amount-btn:active {
  background: var(--color-primary);
  color: #fff;
  transform: scale(0.95);
}

/* 数字键盘网格 */
.keyboard-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.keyboard-key {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-text);
  background: #FFFFFF;
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.1s ease, background-color 0.1s ease, box-shadow 0.1s ease;
}

.keyboard-key:active {
  background: #E8E8E8;
  transform: scale(0.95);
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.06);
}

.keyboard-key-delete {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  background: #E8EAED;
}

.keyboard-key-delete:active {
  background: #D0D3D8;
}

/* 确认金额按钮 - 居中于0下方 */
.keyboard-confirm {
  margin-top: 12rpx;
  display: flex;
  justify-content: center;
}

.keyboard-confirm .btn {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-lg);
}
