/**
 * 订阅编辑页样式
 */

.container {
  padding: 32rpx;
}

/* 金额行 */
.amount-row {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  padding-left: 0;
  overflow: hidden;
}

.amount-row .form-input {
  border: none;
  background: transparent;
}

/* 币种选择器（金额行内） */
.currency-selector {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 88rpx;
  background: var(--color-primary-light);
  border-right: 2rpx solid var(--color-border);
  flex-shrink: 0;
  min-width: 120rpx;
  justify-content: center;
}

.currency-code {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-right: 4rpx;
}

.currency-arrow {
  font-size: 20rpx;
  color: var(--color-primary);
}

/* 人民币换算预览 */
.cny-preview {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  padding-left: 4rpx;
}

/* 周期选择 */
.cycle-grid {
  display: flex;
  gap: 16rpx;
}

.cycle-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  animation: scaleIn 0.2s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.cycle-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 500;
}

/* 提醒天数 */
.remind-grid {
  display: flex;
  gap: 16rpx;
}

.remind-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  animation: scaleIn 0.2s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.remind-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 500;
}

/* 支出分类 */
.form-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-bottom: 16rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.category-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 500;
}

/* 操作按钮 */
.actions {
  margin-top: var(--spacing-xl);
}

.actions .btn {
  height: 96rpx;
  font-size: 32rpx;
  border-radius: var(--radius-xl);
}

/* 币种选择弹窗 */
.currency-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease-out;
}

.currency-modal {
  width: 100%;
  background: var(--color-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease-out;
  max-height: 70vh;
}

.currency-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  text-align: center;
  margin-bottom: 24rpx;
}

.currency-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.currency-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg);
  transition: background-color 0.2s ease;
}

.currency-item.active {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
}

.currency-item:active {
  transform: scale(0.98);
}

.currency-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.currency-item-symbol {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  width: 60rpx;
  text-align: center;
}

.currency-item-info {
  display: flex;
  flex-direction: column;
}

.currency-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.currency-item-code {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
}

.currency-item-check {
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 700;
}

/* 年付均摊开关 */
.spread-yearly-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
}

.spread-yearly-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 16rpx;
}

.spread-yearly-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.spread-yearly-hint {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}
