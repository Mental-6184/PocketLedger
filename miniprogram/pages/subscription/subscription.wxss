/**
 * 订阅管理页样式
 */

.container {
  padding: 32rpx;
  padding-bottom: 120rpx;
  animation: fadeIn 0.3s ease-out;
}

/* 概览 */
.overview-stats {
  display: flex;
  gap: 24rpx;
}

.stat-box {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

/* 区块标题 */
.section {
  margin-top: var(--spacing-lg);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--spacing-md);
  display: block;
}

/* 订阅卡片 */
.sub-card {
  padding: 24rpx;
}

.sub-name {
  font-size: 30rpx;
  font-weight: 500;
}

.sub-status {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.sub-status.active {
  background: var(--color-income);
}

.sub-status.inactive {
  background: var(--color-text-light);
}

/* 操作链接 */
.action-link {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 4rpx 8rpx;
}

.action-link.danger {
  color: var(--color-expense);
}

/* block 辅助 */
.block {
  display: block;
}

/* 换算金额 */
.cny-convert {
  margin-top: 2rpx;
  font-size: 20rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(42, 161, 152, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}
