/**
 * 统计页样式
 */

.container {
  padding: 24rpx 32rpx;
  animation: fadeIn 0.3s ease-out;
}

/* 月份选择器 */
.month-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.month-arrow {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 12rpx 16rpx;
  border-radius: var(--radius-sm);
  transition: background 0.2s;
}

.month-arrow:active {
  background: var(--color-bg);
}

.month-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

/* 月度概览 - 渐变卡片 */
.stats-overview {
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: var(--spacing-md);
  box-shadow: 0 8rpx 24rpx rgba(42, 161, 152, 0.25);
  animation: fadeInUp 0.35s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  position: relative;
  overflow: hidden;
}

/* 微光肌理 */
.stats-overview::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  pointer-events: none;
}

.stats-overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.stats-overview-title {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.9;
}

.stats-overview-count {
  font-size: 22rpx;
  opacity: 0.7;
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.stats-overview-grid {
  display: flex;
  align-items: center;
}

.stats-overview-item {
  flex: 1;
  text-align: center;
}

.so-label {
  font-size: 24rpx;
  opacity: 0.75;
  display: block;
  margin-bottom: 10rpx;
}

.so-value {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
  letter-spacing: -1rpx;
}

/* 货币符号层级 */
.so-value .currency-sym {
  font-size: 0.7em;
  opacity: 0.7;
  font-weight: 500;
}

.stats-overview .amount-income,
.stats-overview .amount-expense {
  color: #fff;
}

.stats-overview-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* 消费健康度 */
.health-bar-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}

.health-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.health-label {
  font-size: 24rpx;
  opacity: 0.75;
}

.health-value {
  font-size: 26rpx;
  font-weight: 600;
}

.health-good { color: #A8F0C6; }
.health-warn { color: #FDEBD0; }
.health-danger { color: #F5B7B1; }

.health-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}

.health-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s ease-out;
  animation: progressGrow 0.6s ease-out both;
  animation-delay: 0.2s;
  transform-origin: left center;
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.health-good-bg { background: #A8F0C6; }
.health-warn-bg { background: #FDEBD0; }
.health-danger-bg { background: #F5B7B1; }

.health-hint {
  margin-top: 12rpx;
}

.health-hint .text-secondary {
  color: rgba(255, 255, 255, 0.7);
}

/* 分类卡片网格 */
.cat-card-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cat-card {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}

.cat-card-top {
  display: flex;
  align-items: center;
}

.cat-card-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cat-card-info {
  flex: 1;
  min-width: 0;
}

.cat-card-name {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
}

.cat-card-amount {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.cat-card-percent {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.cat-card-bar-wrap {
  height: 8rpx;
  background: var(--color-border);
  border-radius: 4rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.cat-card-bar {
  height: 100%;
  border-radius: 4rpx;
  animation: progressGrow 0.6s ease-out both;
  animation-delay: 0.15s;
  transform-origin: left center;
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 图例 */
.legend {
  margin-bottom: var(--spacing-md);
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 12rpx 24rpx;
  display: inline-flex;
}

.legend-item {
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

/* 空状态图表 - 骨架屏风格 */
.empty-state-chart {
  padding: 48rpx 32rpx;
  text-align: center;
}

.skeleton-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.skeleton-bar-group {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 100%;
}

.skeleton-bar {
  width: 24rpx;
  border-radius: 6rpx 6rpx 0 0;
  animation: skeletonPulse 2s ease-in-out infinite;
}

.skeleton-bar.income {
  background: var(--color-income);
  animation-delay: 0s;
}

.skeleton-bar.expense {
  background: var(--color-expense);
  animation-delay: 0.3s;
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.6; }
}

.empty-chart-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* 图表区域 */
.chart-area {
  position: relative;
  height: 420rpx;
  padding-bottom: 40rpx;
}

.chart-grid {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 40rpx;
}

.chart-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: var(--color-divider);
}

.chart-line-label {
  position: absolute;
  left: 0;
  top: -20rpx;
  font-size: 20rpx;
  color: var(--color-text-light);
}

.chart-bars {
  position: absolute;
  left: 60rpx;
  right: 0;
  top: 0;
  bottom: 40rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.chart-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.chart-bar-pair {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 360rpx;
  width: 100%;
  justify-content: center;
}

.chart-bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.chart-bar-val {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.chart-bar {
  width: 28rpx;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.income-bar {
  background: linear-gradient(to top, #27AE60, #2ECC71);
}

.expense-bar {
  background: linear-gradient(to top, #D4605A, #E07A75);
}

.chart-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
  font-weight: 500;
}
