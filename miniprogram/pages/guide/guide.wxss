/**
 * 使用方法页样式
 */

.container {
  padding: 32rpx;
  padding-bottom: 60rpx;
}

/* 顶部欢迎 */
.guide-header {
  text-align: center;
  padding: 40rpx 0 32rpx;
}

.guide-logo {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 8rpx;
}

.guide-subtitle {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
}

/* 目录导航 */
.toc-card {
  padding: 24rpx;
}

.toc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 16rpx;
}

.toc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.toc-item {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  transition: background-color 0.15s ease, transform 0.15s ease;
}

.toc-item:active {
  background: var(--color-primary-light);
  transform: scale(0.96);
}

.toc-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.toc-text {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 模块区块 */
.guide-section {
  margin-top: 16rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  transition: background-color 0.15s ease;
}

.section-header:active {
  background: var(--color-bg);
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-arrow {
  font-size: 32rpx;
  color: var(--color-text-light);
  transition: transform 0.3s;
  transform: rotate(0deg);
}

.section-arrow.expanded {
  transform: rotate(90deg);
}

/* 展开内容 */
.section-body {
  padding: 0 24rpx 28rpx;
  animation: fadeIn 0.2s ease-out;
}

/* 步骤列表 */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: block;
}

/* 信息块 */
.info-block {
  margin-bottom: 20rpx;
}

.info-block:last-of-type {
  margin-bottom: 0;
}

.info-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  display: block;
  margin-bottom: 8rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--color-primary);
}

.info-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  display: block;
  white-space: pre-wrap;
}

/* 提示框 */
.tip-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(42, 161, 152, 0.06);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-top: 20rpx;
  border-left: 4rpx solid var(--color-primary);
}

.tip-box.warning {
  background: rgba(230, 126, 34, 0.06);
  border-left-color: #E67E22;
}

.tip-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  flex: 1;
}
