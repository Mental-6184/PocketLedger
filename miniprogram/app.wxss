/**
 * 全局样式 - 口袋账本
 * 设计规范：奶油白背景、青绿主色、深灰文字
 */

page {
  --color-primary: #2AA198;
  --color-primary-dark: #1E8C82;
  --color-primary-light: #E8F6F4;
  --color-primary-bg: #F0FAF8;
  --color-income: #27AE60;
  --color-income-light: #E8F8F0;
  --color-expense: #D4605A;
  --color-expense-light: #FDF0EF;
  --color-warning: #F39C12;
  --color-warning-light: #FEF5E7;
  --color-bg: #FAF8F5;
  --color-card: #FFFFFF;
  --color-text: #2C3E50;
  --color-text-secondary: #7F8C8D;
  --color-text-light: #BDC3C7;
  --color-border: #ECF0F1;
  --color-divider: #F5F5F5;

  /* 渐变色 */
  --gradient-primary: linear-gradient(135deg, #30B5AD 0%, #2AA198 50%, #238F87 100%);
  --gradient-income: linear-gradient(135deg, #2ECC71 0%, #27AE60 100%);
  --gradient-expense: linear-gradient(135deg, #D4605A 0%, #C0524C 100%);

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 动画时间变量 - 统一维护 */
  --duration-fast: 0.1s;
  --duration-normal: 0.2s;
  --duration-slow: 0.3s;
  --duration-slower: 0.4s;
  --ease-default: ease;
  --ease-out: ease-out;
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.6;
  box-sizing: border-box;
}

/* 通用类 */
.container {
  padding: var(--spacing-lg);
  min-height: 100vh;
  background-color: var(--color-bg);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--spacing-md);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0 var(--spacing-xl);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
}

.btn-primary:active {
  background: var(--color-primary-dark);
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-danger {
  background: var(--color-expense);
  color: #fff;
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 var(--spacing-lg);
  border-radius: var(--radius-md);
}

/* 表单 */
.form-group {
  margin-bottom: var(--spacing-lg);
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-lg);
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
}

.form-input-focus {
  border-color: var(--color-primary);
}

textarea.form-input {
  height: 160rpx;
  padding: var(--spacing-md) var(--spacing-lg);
  line-height: 1.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-lg);
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xl);
}

/* 金额显示 */
.amount {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.amount-income {
  color: var(--color-income);
}

.amount-expense {
  color: var(--color-expense);
}

/* 货币符号（缩小、减淡） */
.currency-symbol-sm {
  font-size: 0.75em;
  opacity: 0.7;
  font-weight: 500;
  margin-right: 2rpx;
}

/* 大号金额数字 */
.amount-lg {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.amount-xl {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

/* 卡片内金额层级 */
.card-amount-row {
  display: flex;
  align-items: baseline;
}

.card-amount-row .currency-symbol-sm {
  font-size: 24rpx;
  opacity: 0.6;
  margin-right: 4rpx;
}

.card-amount-row .amount-value {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

/* 标签/徽章 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-income {
  background: var(--color-income-light);
  color: var(--color-income);
}

.tag-expense {
  background: #FDF0EF;
  color: #D4605A;
}

.tag-warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 16rpx;
  background: var(--color-border);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
  background: var(--color-primary);
}

.progress-fill-warning {
  background: var(--color-warning);
}

.progress-fill-danger {
  background: var(--color-expense);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: var(--spacing-md) 0;
}

/* Flex 工具 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 文字工具 */
.text-sm {
  font-size: 24rpx;
}

.text-xs {
  font-size: 22rpx;
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-bold {
  font-weight: 600;
}

/* 间距工具 */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面底部留白（给 TabBar） */
.page-bottom-space {
  height: 40rpx;
}

/* ============================================
   动画系统（性能优化版）
   ============================================ */

/* GPU 加速提示 - 用于需要动画的元素 */
.gpu-accelerated {
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translateZ(0);
}

/* 关键帧：淡入上移（仅使用 transform + opacity，GPU 加速） */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx) translateZ(0);
  }
  to {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }
}

/* 关键帧：淡入 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 关键帧：缩放弹入（仅使用 transform + opacity，GPU 加速） */
@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.92) translateZ(0);
  }
  to {
    opacity: 1;
    transform: scale(1) translateZ(0);
  }
}

/* 关键帧：从左滑入（仅使用 transform + opacity，GPU 加速） */
@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30rpx) translateZ(0);
  }
  to {
    opacity: 1;
    transform: translateX(0) translateZ(0);
  }
}

/* 关键帧：从右滑入（仅使用 transform + opacity，GPU 加速） */
@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(30rpx) translateZ(0);
  }
  to {
    opacity: 1;
    transform: translateX(0) translateZ(0);
  }
}

/* 关键帧：从底部滑入（用于弹窗、面板） */
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 关键帧：进度条从零增长（使用 scaleX 避免布局重排） */
@keyframes progressGrow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

/* 关键帧：柱状图从底部生长（使用 scaleY 避免布局重排） */
@keyframes barGrow {
  from {
    transform: scaleY(0) translateZ(0);
    opacity: 0;
  }
  to {
    transform: scaleY(1) translateZ(0);
    opacity: 1;
  }
}

/* 关键帧：浮动按钮弹入（GPU 加速） */
@keyframes fabBounce {
  0% {
    opacity: 0;
    transform: scale(0) rotate(-45deg) translateZ(0);
  }
  60% {
    transform: scale(1.1) rotate(0deg) translateZ(0);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg) translateZ(0);
  }
}

/* 关键帧：脉冲提醒 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 关键帧：数字闪烁 */
@keyframes numberFlash {
  0% { color: var(--color-primary); }
  100% { color: inherit; }
}

/* 通用动画类（添加 GPU 加速和 will-change） */
.anim-fade-in {
  animation: fadeIn 0.3s ease-out both;
  will-change: opacity;
}

.anim-fade-in-up {
  animation: fadeInUp 0.35s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 页面容器淡入动画（统一使用） */
.page-fade-in {
  animation: fadeIn 0.3s ease-out;
}

.anim-scale-in {
  animation: scaleIn 0.25s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.anim-slide-left {
  animation: slideInLeft 0.3s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.anim-slide-right {
  animation: slideInRight 0.3s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 卡片入场动画（带交错延迟，限制前3个） */
.card {
  animation: fadeInUp 0.35s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.05s; }
.card:nth-child(3) { animation-delay: 0.1s; }
.card:nth-child(n+4) { animation-delay: 0s; animation-duration: 0.25s; }

/* 列表项交错动画（限制前3个，后续项无延迟） */
.record-item,
.sub-item,
.sub-card,
.category-row {
  animation: fadeInUp 0.3s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.record-item:nth-child(1),
.sub-item:nth-child(1),
.sub-card:nth-child(1),
.category-row:nth-child(1) { animation-delay: 0s; }

.record-item:nth-child(2),
.sub-item:nth-child(2),
.sub-card:nth-child(2),
.category-row:nth-child(2) { animation-delay: 0.05s; }

.record-item:nth-child(3),
.sub-item:nth-child(3),
.sub-card:nth-child(3),
.category-row:nth-child(3) { animation-delay: 0.1s; }

.record-item:nth-child(n+4),
.sub-item:nth-child(n+4),
.sub-card:nth-child(n+4),
.category-row:nth-child(n+4) { animation-delay: 0s; }

/* 按钮交互动画（指定具体属性，避免 transition: all） */
.btn {
  transition: transform 0.15s ease, opacity 0.15s ease;
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.btn:active {
  transform: scale(0.96) translateZ(0);
  opacity: 0.85;
}

/* 悬浮按钮动画（GPU 加速） */
.fab {
  animation: fabBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  animation-delay: 0.2s;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.fab:active {
  transform: scale(0.9) translateZ(0);
  box-shadow: 0 4rpx 12rpx rgba(42, 161, 152, 0.3);
}

/* 标签/徽章动画 */
.tag {
  animation: scaleIn 0.2s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 进度条动画（使用 scaleX，设置 transform-origin） */
.progress-fill {
  animation: progressGrow 0.6s ease-out both;
  animation-delay: 0.15s;
  transform-origin: left center;
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 柱状图动画（使用 scaleY，设置 transform-origin） */
.chart-bar {
  animation: barGrow 0.5s ease-out both;
  transform-origin: bottom center;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.income-bar { animation-delay: 0.08s; }
.expense-bar { animation-delay: 0.15s; }

/* 到期提醒脉冲（仅在可见时动画） */
.tag-warning {
  animation: pulse 2s ease-in-out infinite;
  will-change: opacity;
}

/* 空状态动画 */
.empty-state {
  animation: fadeInUp 0.4s ease-out both;
  animation-delay: 0.08s;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.empty-icon {
  animation: scaleIn 0.3s ease-out both;
  animation-delay: 0.15s;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 交互反馈（指定具体属性，避免 transition: all） */
.record-item:active,
.sub-item:active,
.sub-card:active,
.category-item:active,
.cycle-item:active,
.remind-item:active,
.currency-item:active {
  transform: scale(0.97) translateZ(0);
  opacity: 0.8;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

/* Switch 过渡（指定具体属性） */
switch {
  transition: background-color 0.3s ease, transform 0.3s ease;
}

/* 输入框聚焦动画（指定具体属性） */
.form-input {
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.form-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(42, 161, 152, 0.12);
}

/* 滚动容器 */
.category-scroll,
.chart-area {
  animation: fadeIn 0.25s ease-out both;
  animation-delay: 0.1s;
  will-change: opacity;
}

/* 概览数字区域 */
.overview-stats,
.stat-item {
  animation: fadeIn 0.3s ease-out both;
  will-change: opacity;
}

.stat-item:nth-child(1) { animation-delay: 0.08s; }
.stat-item:nth-child(3) { animation-delay: 0.15s; }
.stat-item:nth-child(5) { animation-delay: 0.22s; }

/* 月份选择器 */
.month-selector {
  animation: fadeInUp 0.25s ease-out both;
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 禁止选中（用于按钮等交互元素） */
.no-select {
  -webkit-user-select: none;
  user-select: none;
}
